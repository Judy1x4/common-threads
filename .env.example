# Copy to .env.local and fill in. .env.local is git-ignored.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Optional, for a public deployment (docs/HOSTING_PLAN.md §2):
# DEMO_ACCESS_CODE=      # if set, only visitors with ?code=<value> get Claude replies
# RATE_LIMIT_PER_10_MIN= # calls per visitor IP per 10 minutes (default 60)
